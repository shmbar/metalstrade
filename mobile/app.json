{
  "expo": {
    "name": "IMS",
    "slug": "zaka-ur-rehman",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ims",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zakarehman.imsmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "buildNumber": "42"
    },
    "android": {
      "package": "com.zakarehman.imsmobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "IMS Tech uses Face ID so you can sign in and unlock the app without typing your password. For example, after you turn on Face ID sign-in, looking at your iPhone opens your company's contracts and invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "IMS Tech uses the camera to photograph paper trade documents so you don't have to type them in. For example, when you add a purchase contract, tap \"Scan with camera\" to photograph a supplier's proforma, and the app reads the supplier, PO number, date, currency and products from the photo into the new contract.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0366ae"
        }
      ],
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1be95028-8056-40a7-8727-fca3102153b1"
      }
    },
    "owner": "zakarehman13s-team"
  }
}
